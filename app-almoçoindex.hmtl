            { id: "78210504355", name: "CAUA VICTOR OLIVEIRA SANTOS", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "71057293610", name: "CHRISLLANE PEREIRA DA CONCEIÇÃO", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78727061256", name: "CRISTIANO DA SILVA MEDEIROS", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78359184836", name: "DANY ELLEM RODRIGUES SILVA", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "79270530809", name: "DOUGLAS GABRIEL DE OLIVEIRA CUNHA", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78699860749", name: "ERIC ALESSANDRO ALVES", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78824537855", name: "ERICK RONNY SOUSA SILVA", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78380247345", name: "ERIK BRUNO LIMA QUARESMA", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78770043744", name: "ERIK RIAN COELHO DA SILVA", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78933677453", name: "EVERTON VINICIUS MIRANDA E SILVA", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78683673898", name: "FRANCISCO ANDRÉ DOS SANTOS", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "78985363328", name: "FRANCISCO CARLOS DA CONCEICAO DE JESUS", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
            { id: "80483834904", name: "FRANCISCO GUSTAVO MARQUES DE SOUSA", turma: "1ª SÉRIE - DESENV. SISTEMAS A" }
        ];

        let records = JSON.parse(localStorage.getItem('almocosCETI2026')) || [];
        let html5QrCode;
        let isProcessingScan = false;
        let audioCtx;

        window.onload = () => {
            document.getElementById('filter-date').value = getTodayDate();
            populateTurmaFilters();
            updateDashboard();
            generateBadges();
            renderHistory();
        };

        function populateTurmaFilters() {
            const turmas = [...new Set(students.map(s => s.turma))].sort();
            const selectPrint = document.getElementById('select-turma-print');
            const selectHistory = document.getElementById('filter-turma');

            turmas.forEach(turma => {
                selectPrint.add(new Option(turma, turma));
                selectHistory.add(new Option(turma, turma));
            });
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');

            if(tabId !== 'tab-scanner' && html5QrCode && html5QrCode.isScanning) {
                stopScanner();
            }
        }

        function getTodayDate() {
            const today = new Date();
            today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
            return today.toISOString().split('T')[0];
        }

        function getCurrentTime() {
            const now = new Date();
            return now.toLocaleTimeString('pt-BR', { hour12: false }).substring(0, 8);
        }

        function formatDisplayDate(dateString) {
            const parts = dateString.split('-');
            if(parts.length !== 3) return dateString;
            return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playBeep(isSuccess) {
            try {
                if (!audioCtx) initAudio();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                if (isSuccess) {
                    oscillator.type = 'sine';
                    oscillator.frequency.setValueAtTime(800, audioCtx.currentTime);
                    gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                    oscillator.start();
                    oscillator.stop(audioCtx.currentTime + 0.15);
                } else {
                    oscillator.type = 'sawtooth';
                    oscillator.frequency.setValueAtTime(150, audioCtx.currentTime);
                    gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                    oscillator.start();
                    oscillator.stop(audioCtx.currentTime + 0.6);
                }
            } catch(e) {
                console.log("Erro de áudio no iOS: ", e);
            }
        }

        function updateDashboard() {
            const today = getTodayDate();
            const todayRecords = records.filter(r => r.data === today);
            
            document.getElementById('dash-total').innerText = students.length;
            document.getElementById('dash-comeram').innerText = todayRecords.length;
            document.getElementById('dash-faltam').innerText = students.length - todayRecords.length;
        }

        async function startScanner() {
            initAudio();

            // Verificação de ambiente seguro (HTTPS) para o Safari iOS
            if (location.protocol !== 'https:' && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
                alert("O Safari (iOS) bloqueia a câmara se o site não estiver a ser executado via HTTPS.\n\nPara funcionar no iPhone, coloque o ficheiro no GitHub Pages ou num servidor HTTPS.");
                return;
            }

            document.getElementById('btn-start').style.display = 'none';
            document.getElementById('btn-stop').style.display = 'block';

            if (!html5QrCode) {
                html5QrCode = new Html5Qrcode("reader");
            }

            const config = { 
                fps: 10, 
                qrbox: { width: 220, height: 220 }
            };

            try {
                // Obter câmaras disponíveis para contornar o problema de sintaxe do iOS
                const devices = await Html5Qrcode.getCameras();
                if (devices && devices.length) {
                    // Tentar encontrar a câmara traseira ("back", "environment" ou última da lista)
                    let backCamera = devices.find(device => 
                        device.label.toLowerCase().includes('back') || 
                        device.label.toLowerCase().includes('traseira') ||
                        device.label.toLowerCase().includes('environment')
                    );
                    
                    const cameraId = backCamera ? backCamera.id : devices[devices.length - 1].id;

                    await html5QrCode.start(cameraId, config, onScanSuccess, onScanFailure);
                } else {
                    // Tentar seleção genérica
                    await html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess, onScanFailure);
                }

                // Correção específica para o Safari iOS: forçar o atributo 'playsinline'
                const videoElem = document.querySelector("#reader video");
                if (videoElem) {
                    videoElem.setAttribute("playsinline", "true");
                    videoElem.setAttribute("webkit-playsinline", "true");
                }

            } catch (err) {
                alert("Erro ao aceder à câmara no Safari/iOS: " + err);
                document.getElementById('btn-start').style.display = 'block';
                document.getElementById('btn-stop').style.display = 'none';
            }
        }

        function stopScanner() {
            if (html5QrCode && html5QrCode.isScanning) {
                html5QrCode.stop().then(() => {
                    document.getElementById('btn-start').style.display = 'block';
                    document.getElementById('btn-stop').style.display = 'none';
                }).catch(err => console.error(err));
            }
        }

        function onScanSuccess(decodedText) {
            if (isProcessingScan) return;
            isProcessingScan = true; 
            
            processQRCode(decodedText);

            setTimeout(() => {
                isProcessingScan = false;
                hideFeedback();
            }, 2500);
        }

        function onScanFailure(error) {
            // Silencioso para frames sem QR Code
        }

        function processQRCode(matriculaLida) {
            const student = students.find(s => s.id === matriculaLida.trim());
            const today = getTodayDate();

            if (!student) {
                showFeedback(false, { id: matriculaLida, name: "QR CODE NÃO CADASTRADO", turma: "Desconhecida" }, "--:--");
                return;
            }

            const recordExists = records.find(r => r.matricula === student.id && r.data === today);

            if (recordExists) {
                showFeedback(false, student, recordExists.horario);
            } else {
                const newRecord = {
                    id: Date.now().toString(),
                    data: today,
                    horario: getCurrentTime(),
                    matricula: student.id,
                    nome: student.name,
                    turma: student.turma
                };
                
                records.push(newRecord);
                localStorage.setItem('almocosCETI2026', JSON.stringify(records));
                
                updateDashboard();
                renderHistory();
                showFeedback(true, student, newRecord.horario);
            }
        }

        function showFeedback(isSuccess, student, horario) {
            playBeep(isSuccess);
            
            const overlay = document.getElementById('feedback-overlay');
            const backdrop = document.getElementById('backdrop');
            
            overlay.className = 'feedback-overlay ' + (isSuccess ? 'success' : 'error');
            document.getElementById('feedback-title').innerText = isSuccess ? "ALMOÇO LIBERADO" : "JÁ ALMOÇOU HOJE";
            document.getElementById('feedback-matricula').innerText = `RA: ${student.id}`;
            document.getElementById('feedback-nome').innerText = student.name;
            document.getElementById('feedback-turma').innerText = student.turma;
            document.getElementById('feedback-horario').innerText = isSuccess ? `Registrado às: ${horario}` : `1º Registro às: ${horario}`;
            
            backdrop.style.display = 'block';
            overlay.style.display = 'block';
        }

        function hideFeedback() {
            document.getElementById('backdrop').style.display = 'none';
            document.getElementById('feedback-overlay').style.display = 'none';
        }

        function generateBadges() {
            const container = document.getElementById('badges-container');
            const turmaFiltro = document.getElementById('select-turma-print').value;
            container.innerHTML = '';

            const svgIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>`;
            const alunosPrint = turmaFiltro === 'all' ? students : students.filter(s => s.turma === turmaFiltro);

            alunosPrint.forEach(student => {
                const badge = document.createElement('div');
                badge.className = 'badge';
                
                badge.innerHTML = `
                    ${svgIcon}
                    <div id="qr-${student.id}" style="margin: 8px 0;"></div>
                    <h4>${student.name}</h4>
                    <p>RA: ${student.id}</p>
                    <div class="turma">${student.turma}</div>
                `;
                
                container.appendChild(badge);

                setTimeout(() => {
                    const elem = document.getElementById(`qr-${student.id}`);
                    if(elem) {
                        new QRCode(elem, {
                            text: student.id,
                            width: 90,
                            height: 90,
                            colorDark : "#0f172a",
                            colorLight : "#ffffff",
                            correctLevel : QRCode.CorrectLevel.H
                        });
                    }
                }, 20);
            });
        }

        function renderHistory() {
            const filterDate = document.getElementById('filter-date').value;
            const filterTurma = document.getElementById('filter-turma').value;
            const filterName = document.getElementById('filter-name').value.toLowerCase();
            const filterMat = document.getElementById('filter-matricula').value.toLowerCase();
            
            const tbody = document.getElementById('history-tbody');
            tbody.innerHTML = '';

            const filteredRecords = records.filter(r => {
                const matchDate = filterDate ? r.data === filterDate : true;
                const matchTurma = filterTurma === 'all' ? true : r.turma === filterTurma;
                const matchName = r.nome.toLowerCase().includes(filterName);
                const matchMat = r.matricula.toLowerCase().includes(filterMat);
                return matchDate && matchTurma && matchName && matchMat;
            }).sort((a, b) => {
                if (a.data !== b.data) return b.data.localeCompare(a.data);
                return b.horario.localeCompare(a.horario);
            });

            if(filteredRecords.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center">Nenhum registro encontrado.</td></tr>`;
                return;
            }

            filteredRecords.forEach(r => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${formatDisplayDate(r.data)}</td>
                    <td>${r.horario}</td>
                    <td>${r.turma}</td>
                    <td>${r.matricula}</td>
                    <td>${r.nome}</td>
                    <td><button class="btn-estornar" onclick="deleteRecord('${r.id}')">Apagar</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        function deleteRecord(id) {
            if(confirm('Tem certeza que deseja apagar este registo?')) {
                records = records.filter(r => r.id !== id);
                localStorage.setItem('almocosCETI2026', JSON.stringify(records));
                updateDashboard();
                renderHistory();
            }
        }
    </script>
</body>
</html>
