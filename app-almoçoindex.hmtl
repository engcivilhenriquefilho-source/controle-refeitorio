            { id: "78721844550", name: "YSLLANE ELLY SOUSA OLIVEIRA", turma: "1ª SÉRIE - FARMÁCIA A" },

            // 1ª SÉRIE - DESENV. SISTEMAS A
            { id: "58719404778", name: "ALESSANDRA ESMERALDA DE OLIVEIRA DANTAS", turma: "1ª SÉRIE - DESENV. SISTEMAS A" },
